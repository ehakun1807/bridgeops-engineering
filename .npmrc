# React 19 + @testing-library/react 15 have a known peer-dep conflict —
# testing-library 15 peer-requires React 18, but the project ships React 19.
# Local installs work because npm honors the user's global legacy-peer-deps
# setting; Vercel runs strict resolution by default and fails the build with
# ERESOLVE. Setting it here mirrors local behavior and unblocks deploys.
#
# Cleanup path: bump @testing-library/react to ^16.0.0 (the first version
# whose peer range includes React 19). Once that's done this file can be
# deleted.
legacy-peer-deps=true
